# =============================================================================
# Spinozah AI Education — environment template
# =============================================================================
# Copy this file to `.env.local` in the project root (never commit `.env.local`):
#
#   cp .env.example .env.local
#
# Next.js loads `.env.local` automatically for `npm run dev` and `npm run build`.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
# Public app URL (optional; useful for magic links and redirects)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Backend API (FastAPI — backend/ scaffold; see backend/README.md)
# -----------------------------------------------------------------------------
# Base URL for the Python API. Used by the frontend API client / TanStack Query.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional backend process settings (copy into backend/.env if needed)
# ENVIRONMENT=development
# DEBUG=false

# -----------------------------------------------------------------------------
# AI (server-side only — Next.js Route Handlers or future FastAPI)
# -----------------------------------------------------------------------------
# Do NOT prefix with NEXT_PUBLIC_. Never expose this key in client code.
# OPENAI_API_KEY=sk-your-openai-api-key
# Optional: override default model (used by all lib/ai-analysis analyzers)
# OPENAI_MODEL=gpt-4o-mini
# Optional LangSmith tracing for Deep Agents prototypes (scripts/deep-agents/)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_...
# LANGCHAIN_PROJECT=spinozah-ai-education

# -----------------------------------------------------------------------------
# Database (FastAPI backend — AIJOB-29+)
# -----------------------------------------------------------------------------
# Async SQLAlchemy URL (asyncpg). Used by Alembic and the API session factory.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/spinozah

# -----------------------------------------------------------------------------
# Auth (FastAPI backend — AIJOB-35)
# -----------------------------------------------------------------------------
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=dev-only-change-me-use-secrets-token-urlsafe
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# AWS S3 — file uploads (exams, essays; target backend)
# -----------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=spinozah-uploads
# AWS_REGION=ap-southeast-1

# -----------------------------------------------------------------------------
# CORS (target: FastAPI backend — comma-separated origins)
# -----------------------------------------------------------------------------
# CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Linear (issue tracking — Cursor MCP / API; server-side / tooling only)
# -----------------------------------------------------------------------------
# LINEAR_API_KEY=lin_api_your-linear-api-key
