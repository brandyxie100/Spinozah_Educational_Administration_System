# Copy to .env.prod and fill in. Replace <EC2_IP> with the instance's Elastic IP.
POSTGRES_PASSWORD=change-me
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me
# Use "production" only once the site is served over HTTPS (Secure cookie).
ENVIRONMENT=staging
CORS_ORIGINS=http://<EC2_IP>
MAGIC_LINK_BASE_URL=http://<EC2_IP>/parent/magic-link
# Baked into the web bundle at build time.
NEXT_PUBLIC_API_URL=http://<EC2_IP>
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
